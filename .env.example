# ==============================================================================
# JARVIS 3.0 / SYNCHRO — Environment Configuration
# ==============================================================================

# Flutter Web & Mobile API Target
# Provide this at build time via --dart-define=SYNCHRO_API=...
# In release mode on Android, default falls back to the production HTTPS URL.
SYNCHRO_API=http://localhost:8000

# Backend Runtime Settings (FastAPI / Uvicorn / Docker / Cloud PaaS)
PORT=8000
HOST=0.0.0.0
SYNCHRO_DB=/data/synchro.db
SYNCHRO_CORS_ORIGINS=*
# Docker sets SYNCHRO_WEB_DIR=web-build and PORT=8080 for same-origin hosting.

# Server-only. Never pass these through --dart-define or frontend bundles.
# Set a fresh key in your terminal or deployment secret manager, not in git.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
